# Private runtime artifacts are intentionally absent from the public repository.
export RFIC_Q_SWEEP_MODEL_DIR=/private/path/to/deployed100k/model
export RFIC_Q_SWEEP_MODEL_PROFILE=deployed100k
export RFIC_Q_SWEEP_PYTHON=/private/path/to/the/same/venv/bin/python

# GDS-download mode: structured binary GDS only; EMX, DRC, and HFSS stay NOT_RUN.
export RFIC_Q_SWEEP_MODE=proxy
# export RFIC_Q_SWEEP_MODE=layout  # Explicitly enable only with an audited backend.
export RFIC_Q_SWEEP_LAYOUT_BACKEND="/private/path/to/the/same/venv/bin/python -m rfic_transformer_inverse_design.synthesis.q_sweep_layout_backend --config /private/path/to/approved_grounded_4port_config.yaml --config-sha256 <64-hex-config-sha256> --process-sha256 <64-hex-process-sha256>"

# Fresh real-EMX mode is a separate launch and requires its own load/license gate.
# export RFIC_Q_SWEEP_MODE=physical
export RFIC_Q_SWEEP_PHYSICAL_BACKEND="/private/path/to/the/same/venv/bin/python -m rfic_transformer_inverse_design.synthesis.q_sweep_physical_backend --config /private/path/to/approved_grounded_4port_config.json --config-sha256 <64-hex-config-sha256> --process-sha256 <64-hex-process-sha256>"
export RFIC_Q_SWEEP_OUTPUT_ROOT=/private/no-clobber/output/root
export RFIC_Q_SWEEP_HOST=127.0.0.1
export RFIC_Q_SWEEP_PORT=8765
